{
  "name": "lexico-vivo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "prisma generate && vite build",
    "start": "node scripts/start.mjs",
    "db:prepare": "node scripts/prepare.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "moderate": "tsx scripts/moderate.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib prisma scripts tests *.ts *.json *.yaml *.md"
  },
  "dependencies": {
    "@fontsource/merriweather": "^5.2.10",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.3",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.577.0",
    "prisma": "7.10.1",
    "re2js": "^2.8.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "tsx": "^4.21.0",
    "vinext": "1.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitejs/plugin-rsc": "^0.5.37",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  },
  "overrides": {
    "fflate": "^0.8.3"
  }
}

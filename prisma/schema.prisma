generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Entry {
  id          Int      @id
  slug        String   @unique
  headword    String
  normalized  String
  definitions Json
  synonyms    Json
  fields      Json
  sections    Json
  pages       Json
  region      String   @default("")
  register    String   @default("")
  kind        String   @default("word")
  source      String   @default("original")
  createdAt   DateTime @default(now())
  votes       Vote[]
  contributions Contribution[]

  @@index([normalized])
  @@index([region])
}

model Contribution {
  id         String   @id @default(cuid())
  headword   String
  definition String
  example    String   @default("")
  region     String   @default("")
  name       String   @default("")
  clientId   String
  status     String   @default("PENDING")
  entryId    Int?
  entry      Entry?   @relation(fields: [entryId], references: [id])
  createdAt  DateTime @default(now())

  @@index([clientId, createdAt])
}

model Vote {
  id        String @id @default(cuid())
  entryId   Int
  entry     Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  clientId  String
  value     String

  @@unique([entryId, clientId])
}
